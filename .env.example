# 保持 demo 即可查看页面交互；准备好企微权限后改为 cli。
WECOM_SOURCE=demo
WECOM_CLI_COMMAND=wecom-cli
# 官方 chat messages 接口会返回会话双方的消息；这里必须填写“该接口中你自己发出消息的 userid 原值”。
# 该字段在 chat 接口中会被框架加密，不能用 contact users search 的 userid 替代。
WECOM_SELF_MESSAGE_USERID=
# 轮询间隔，最低 30000 毫秒。
WECOM_POLL_INTERVAL_MS=120000

# DeepSeek 的 OpenAI 兼容接口配置。填入令牌后，导入文字消息会自动生成摘要。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PORT=3210
